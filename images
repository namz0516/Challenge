#fuzzy ocr detection to detect regex similar values


FUZZY_FLAG = re.compile(
    r"""
    V\s*[I1l]\s*S\s*[Uu]\s*A\s*[L]\s*
    P\s*[I1l]\s*N\s*[Gg]
    \s*
    \{
    [^{}\n]{10,24}
    \}
    """,
    re.IGNORECASE | re.VERBOSE
)


#ocr where opening brace is wrong or missing
FUZZY_BODY = re.compile(
    r"""
    V\s*[I1l]\s*S\s*[Uu]\s*A\s*[L]\s*
    P\s*[I1l]\s*N\s*[Gg]
    .{0,5}
    [0-9A-Za-zOoIl]{12,22}
    """,
    re.IGNORECASE | re.VERBOSE
)


